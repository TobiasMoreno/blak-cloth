{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "BLAK Streetwear",
        "supportEmail": "tobiasmoreno.tm.21@gmail.com",
        "authorizedRedirectUris": [
          "https://blakstreetwear-7dd9b.firebaseapp.com/__/auth/handler",
          "https://blakstreetwear.web.app/__/auth/handler",
          "https://blakstreetwear.netlify.app/__/auth/handler",
          "http://localhost:4200/__/auth/handler"
        ]
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "southamerica-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "blakstreetwear",
    "public": "dist/lm-studio/browser",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/product/001",
        "destination": "/product/positive-energy",
        "type": 301
      },
      {
        "source": "/product/002",
        "destination": "/product/stitch-art",
        "type": 301
      },
      {
        "source": "/product/003",
        "destination": "/product/the-rose-system",
        "type": 301
      },
      {
        "source": "/product/004",
        "destination": "/product/blak-minimal-series-001",
        "type": 301
      },
      {
        "source": "/product/005",
        "destination": "/product/blak-minimal-series-002",
        "type": 301
      },
      {
        "source": "/product/006",
        "destination": "/product/medusa",
        "type": 301
      },
      {
        "source": "/product/007",
        "destination": "/product/take-control",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/gestion/**",
        "destination": "/gestion.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/cart",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/gestion{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ]
  }
}
